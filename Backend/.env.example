# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (Database → Connect → Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/airquality?retryWrites=true&w=majority

# JWT secret for dashboard user authentication — use a long random string
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Shared secret the ESP32 device(s) send as the x-api-key header.
# Must match DEVICE_API_KEY in Arduino/AirQualityNode/config.h
API_KEY=CHANGE_ME_SHARED_SECRET

# Comma-separated list of origins allowed to call the API (your
# frontend's dev and production URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Google Weather / Geocoding API Key
GOOGLE_WEATHER_API_KEY=your_google_weather_api_key_here

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Website Email Service for Password Resets (airguard396@gmail.com)
# Generate a Google App Password from: https://myaccount.google.com/apppasswords
EMAIL_USER=airguard396@gmail.com
EMAIL_PASS=your_16_character_gmail_app_password
EMAIL_FROM=airguard396@gmail.com
APP_URL=https://airguard-hyperlocal.vercel.app

