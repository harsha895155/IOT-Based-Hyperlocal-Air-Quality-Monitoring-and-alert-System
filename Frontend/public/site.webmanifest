{
  "name": "AirGuard — Hyperlocal Air Quality & Weather",
  "short_name": "AirGuard",
  "description": "Real-Time Hyperlocal Air Quality Monitoring, Weather Telemetry & Smart Alerts",
  "id": "/",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "tabbed", "standalone", "minimal-ui"],
  "tab_strip": {
    "home_tab": {
      "scope": "/",
      "url": "/dashboard"
    },
    "new_tab_button": {
      "url": "/locations"
    }
  },
  "launch_handler": {
    "client_mode": "auto"
  },
  "share_target": {
    "action": "/dashboard",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "/dashboard",
      "name": "AirGuard Sensor Data",
      "icons": [
        { "src": "/favicon-96x96.png", "sizes": "96x96", "type": "image/png" }
      ],
      "accept": {
        "application/json": [".json"],
        "text/csv": [".csv"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+airguard",
      "url": "/dashboard?station=%s"
    }
  ],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "widgets": [
    {
      "name": "AirGuard AQI Glance",
      "short_name": "AQI",
      "description": "Real-time Hyperlocal Air Quality Glance Widget",
      "tag": "airguard-aqi",
      "template": "widget-template",
      "ms_ac_template": "widgets/airguard.json",
      "data": "/api/readings/latest",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/screenshot-desktop.png",
          "sizes": "1376x768",
          "label": "AirGuard Widget"
        }
      ],
      "icons": [
        {
          "src": "/android-chrome-192x192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "edge_side_panel": {
    "preferred_width": 480
  },
  "note_taking": {
    "new_note_url": "/dashboard?action=new-log"
  },
  "scope_extensions": [
    {
      "origin": "https://iot-based-hyperlocal-air-quality.onrender.com"
    }
  ],
  "orientation": "any",
  "background_color": "#070a10",
  "theme_color": "#0284c7",
  "categories": ["weather", "utilities", "health", "lifestyle"],
  "lang": "en-US",
  "dir": "ltr",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=app.vercel.airguard_hyperlocal",
      "id": "app.vercel.airguard_hyperlocal"
    }
  ],
  "icons": [
    {
      "src": "/favicon-48x48.png",
      "sizes": "48x48",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/favicon-96x96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-desktop.png",
      "sizes": "1376x768",
      "type": "image/png",
      "form_factor": "wide",
      "label": "AirGuard Hyperlocal Air Quality & Atmospheric Telemetry Dashboard"
    },
    {
      "src": "/screenshot-mobile.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "AirGuard Mobile Air Quality Station & Live Atmospheric Readings"
    }
  ],
  "shortcuts": [
    {
      "name": "Live Dashboard",
      "short_name": "Dashboard",
      "description": "View real-time air quality & weather",
      "url": "/dashboard",
      "icons": [{ "src": "/favicon-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "Weather Search",
      "short_name": "Weather",
      "description": "Search global weather forecasts",
      "url": "/locations",
      "icons": [{ "src": "/favicon-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "Connected Devices",
      "short_name": "Devices",
      "description": "Manage IoT sensing hardware",
      "url": "/devices",
      "icons": [{ "src": "/favicon-96x96.png", "sizes": "96x96" }]
    }
  ]
}
